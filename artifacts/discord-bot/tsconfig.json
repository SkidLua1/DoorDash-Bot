{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@workspace/db": ["../../lib/db/src/index.ts"],
      "@workspace/db/schema": ["../../lib/db/src/schema/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../../lib/db" }]
}
