# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Your personal Discord user ID (right-click your name → Copy User ID)
# Enable Developer Mode in Discord Settings → Advanced first.
OWNER_DISCORD_ID=123456789012345678

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Free options: https://neon.tech  |  https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret from https://dashboard.stripe.com/webhooks
# Point the webhook to: https://your-api-server/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Session / Dashboard ──────────────────────────────────────────────────────
# Random secret string used for encryption (any long random string works).
SESSION_SECRET=change-me-to-a-long-random-string

# Token to log into the owner dashboard (optional — falls back to SESSION_SECRET)
DASHBOARD_TOKEN=qwerty
